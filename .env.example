# Google AI Studio / Vertex AI Gemini API key.
# Leave empty to run the deterministic offline advisory generator (clearly labelled in the UI).
VITE_GEMINI_API_KEY=

# Model id used for advisory drafting. Any Gemini Flash model id works.
VITE_GEMINI_MODEL=gemini-2.5-flash

# ── Google Maps Platform · Weather API ──────────────────────────────────────
# RECOMMENDED — server-side key (never visible to site visitors):
#   GOOGLE_API_KEY=<key>
# The dev/preview server proxies /api/weather/* and attaches this key itself.
# A Maps Demo Key works (free, no billing): https://mapsplatform.google.com/maps-demo-key/
GOOGLE_API_KEY=

# Alternative — build-time key baked into the bundle (fine for local use only;
# anyone visiting the site can read it in the JS): VITE_GOOGLE_API_KEY=<key>
VITE_GOOGLE_API_KEY=

# The client picks proxy mode automatically when the page is served by
# `vite dev` / `vite preview` (VITE_WEATHER_PROXY is set by vite.config.ts).
# Set it to 1 yourself only for a custom static server that mirrors the proxy.
VITE_WEATHER_PROXY=

# ── Google Earth Engine · satellite basemap ────────────────────────────────
# Earth Engine cannot use an API key — it needs an OAuth 2.0 *Web application*
# client ID from a Cloud project registered for Earth Engine (the map's
# "Earth Engine setup" panel accepts the same values at runtime).
# Console → APIs & Services → Credentials → Create credentials → OAuth client ID.
VITE_EE_CLIENT_ID=

# Earth Engine–enabled Cloud project id passed to ee.initialize().
VITE_EE_PROJECT=
