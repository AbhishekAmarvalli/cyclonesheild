{
  "name": "cyclonesheild",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:analysis": "esbuild scripts/sanity-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sanity.mjs --log-level=error && node node_modules/.cache/sanity.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.9.0",
    "@turf/turf": "^7.2.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.17",
    "@types/leaflet": "^1.9.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "http-proxy": "^1.18.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
